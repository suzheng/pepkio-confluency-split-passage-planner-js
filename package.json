{
  "name": "pepkio-confluency-split-passage-planner",
  "version": "0.1.0",
  "description": "Calculate cell culture split ratios, seeding densities, harvest yields, and growth timelines from Node.js and TypeScript via the Pepkio REST API.",
  "readme": "README_NPM.md",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-confluency-split-passage-planner": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_NPM.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-confluency-split-passage-planner-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-confluency-split-passage-planner-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/confluency-split-passage-planner",
  "keywords": [
    "confluency-split-passage-planner",
    "cell-culture",
    "tissue-culture",
    "passaging",
    "confluency",
    "split-ratio",
    "doubling-time",
    "adherent",
    "suspension",
    "cell-seeding",
    "vessel-surface-area",
    "pepkio",
    "laboratory-tools",
    "life-sciences",
    "typescript",
    "node",
    "rest-api",
    "scientific-computing"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.2"
  }
}
